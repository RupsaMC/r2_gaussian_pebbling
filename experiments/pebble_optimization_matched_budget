import csv
from pathlib import Path

import numpy as np
from scipy.spatial import cKDTree
from scipy.sparse import coo_matrix, eye
from scipy.sparse.linalg import cg


K = 6
WEIGHT_K = 6.0
LAMBDA = 1.0
LR = 0.02
STEPS = 200

# These are approximately the edge budgets previously reached
# by the adaptive method at 1%, 5%, and 10% selected nodes.
TARGET_EDGE_BUDGETS = [16_000, 50_000, 75_000]

RANDOM_SEEDS = [0, 1, 2, 3, 4]

DATASET = Path(
    "~/r2_gaussian/data/synthetic_dataset/"
    "cone_ntrain_50_angle_360/0_chest_cone/"
    "init_0_chest_cone.npy"
).expanduser()

OUT = Path("~/r2_gaussian/experiments").expanduser()
OUT.mkdir(parents=True, exist_ok=True)


def build_graph(points, k):
    tree = cKDTree(points)
    _, nbrs = tree.query(points, k=k + 1)
    nbrs = nbrs[:, 1:]

    edges = set()

    for i in range(len(points)):
        for j in nbrs[i]:
            i = int(i)
            j = int(j)

            if i == j:
                continue

            edges.add((min(i, j), max(i, j)))

    edges = np.asarray(sorted(edges), dtype=np.int64)

    return edges, nbrs


def edge_weights(points, edges, k):
    i = edges[:, 0]
    j = edges[:, 1]

    d = points[i] - points[j]
    dist2 = np.sum(d * d, axis=1)

    return np.exp(-dist2 / k)


def build_sparse_laplacian(n, edges, weights):
    i = edges[:, 0]
    j = edges[:, 1]

    rows = np.concatenate([i, j, i, j])
    cols = np.concatenate([j, i, i, j])

    data = np.concatenate([
        -weights,
        -weights,
        weights,
        weights,
    ])

    return coo_matrix(
        (data, (rows, cols)),
        shape=(n, n),
    ).tocsr()


def objective(rho, rho0, edges, weights):
    diff = rho[edges[:, 0]] - rho[edges[:, 1]]

    return (
        0.5 * np.sum((rho - rho0) ** 2)
        + LAMBDA * np.sum(weights * diff * diff)
    )


def full_gradient(rho, rho0, L):
    return (rho - rho0) + 2.0 * LAMBDA * (L @ rho)


def region_from_selected(selected, knn):
    region = np.unique(
        np.concatenate([
            np.asarray(selected, dtype=np.int64),
            knn[np.asarray(selected, dtype=np.int64)].reshape(-1),
        ])
    )
    region.sort()
    return region


def touched_edge_count(region, edges):
    max_node = int(edges.max())

    inside = np.zeros(max_node + 1, dtype=bool)
    inside[region] = True

    i = edges[:, 0]
    j = edges[:, 1]

    return int(np.count_nonzero(inside[i] | inside[j]))


def select_by_budget(order, knn, edges, budget):
    """
    Add nodes from 'order' until the expanded region would exceed
    the edge budget. Returns selected nodes and the final region.
    """
    selected = []

    region_mask = np.zeros(int(edges.max()) + 1, dtype=bool)

    # Track region incrementally through a Python set. The graph is
    # only 50k nodes, so this keeps the experiment straightforward.
    region_set = set()

    for node in order:
        node = int(node)

        candidate = set([node])
        candidate.update(int(x) for x in knn[node])

        proposed_region = region_set | candidate

        # Build a numpy region only when checking the budget.
        proposed = np.fromiter(
            proposed_region,
            dtype=np.int64,
        )

        touched = touched_edge_count(
            proposed,
            edges,
        )

        if touched > budget and selected:
            continue

        selected.append(node)
        region_set = proposed_region

        if touched >= budget:
            break

    region = np.fromiter(
        region_set,
        dtype=np.int64,
    )
    region.sort()

    return np.asarray(selected, dtype=np.int64), region


def local_gradient_exact(
    rho,
    rho0,
    region,
    edges,
    weights,
):
    """
    Exact global weighted Laplacian action restricted to 'region',
    using only edges that touch the region.
    """
    n = len(rho)

    inside = np.zeros(n, dtype=bool)
    inside[region] = True

    i = edges[:, 0]
    j = edges[:, 1]

    mask = inside[i] | inside[j]

    touched_edges = edges[mask]
    touched_weights = weights[mask]

    local_index = {
        int(node): idx
        for idx, node in enumerate(region)
    }

    grad = rho[region] - rho0[region]

    for (u, v), w in zip(
        touched_edges,
        touched_weights,
    ):
        u = int(u)
        v = int(v)

        if inside[u] and inside[v]:
            d = w * (rho[u] - rho[v])

            grad[local_index[u]] += 2.0 * LAMBDA * d
            grad[local_index[v]] -= 2.0 * LAMBDA * d

        elif inside[u]:
            d = w * (rho[u] - rho[v])
            grad[local_index[u]] += 2.0 * LAMBDA * d

        else:
            d = w * (rho[v] - rho[u])
            grad[local_index[v]] += 2.0 * LAMBDA * d

    return grad, int(mask.sum())


def run_budgeted_method(
    rho0,
    edges,
    weights,
    knn,
    rho_star,
    budget,
    method,
    rng=None,
):
    rho = rho0.copy()

    n = len(rho)

    # Weighted degree is static.
    weighted_degree = np.zeros(n)

    np.add.at(
        weighted_degree,
        edges[:, 0],
        weights,
    )
    np.add.at(
        weighted_degree,
        edges[:, 1],
        weights,
    )

    mean_edges = []

    for step in range(STEPS):
        diff = rho[edges[:, 0]] - rho[edges[:, 1]]
        edge_energy = weights * diff * diff

        if method == "adaptive":
            score = np.zeros(n)

            np.add.at(
                score,
                edges[:, 0],
                edge_energy,
            )
            np.add.at(
                score,
                edges[:, 1],
                edge_energy,
            )

            order = np.argsort(score)[::-1]

        elif method == "weighted_degree":
            order = np.argsort(weighted_degree)[::-1]

        elif method == "random":
            order = rng.permutation(n)

        else:
            raise ValueError(method)

        selected, region = select_by_budget(
            order,
            knn,
            edges,
            budget,
        )

        grad_region, touched_edges = local_gradient_exact(
            rho,
            rho0,
            region,
            edges,
            weights,
        )

        rho[region] -= LR * grad_region

        mean_edges.append(touched_edges)

    final_obj = objective(
        rho,
        rho0,
        edges,
        weights,
    )

    dist = np.linalg.norm(
        rho - rho_star
    )

    return {
        "final_objective": final_obj,
        "dist_to_optimum": dist,
        "mean_edges": float(np.mean(mean_edges)),
        "final_edges": int(mean_edges[-1]),
    }


def main():
    print("Loading:", DATASET)

    x = np.load(
        DATASET,
        allow_pickle=False,
    )

    points = x[:, :3].astype(np.float64)
    rho0 = x[:, 3].astype(np.float64)

    n = len(rho0)

    print("Nodes:", n)

    edges, knn = build_graph(
        points,
        K,
    )

    weights = edge_weights(
        points,
        edges,
        WEIGHT_K,
    )

    L = build_sparse_laplacian(
        n,
        edges,
        weights,
    )

    print("Edges:", len(edges))
    print("Laplacian nnz:", L.nnz)

    # ---------------------------------------------------------
    # EXACT FULL-GRAPH OPTIMUM
    # ---------------------------------------------------------

    A = eye(n, format="csr") + 2.0 * LAMBDA * L

    print("\nSolving exact full objective...")

    rho_star, info = cg(
        A,
        rho0,
        tol=1e-8,
        atol=1e-10,
        maxiter=2000,
    )

    if info != 0:
        raise RuntimeError(
            f"Conjugate gradient failed with info={info}"
        )

    optimum = objective(
        rho_star,
        rho0,
        edges,
        weights,
    )

    print(
        f"Exact optimum objective: "
        f"{optimum:.8e}"
    )

    rows = []

    print("\nMATCHED EDGE-BUDGET RESULTS")

    for budget in TARGET_EDGE_BUDGETS:
        print(f"\n=== Target ~{budget:,} edges ===")

        # Adaptive.
        print("Adaptive...")
        result = run_budgeted_method(
            rho0,
            edges,
            weights,
            knn,
            rho_star,
            budget,
            "adaptive",
        )

        rows.append({
            "method": "adaptive",
            "target_edges": budget,
            "seed": "",
            **result,
        })

        print(
            f"  objective={result['final_objective']:.8e}, "
            f"dist={result['dist_to_optimum']:.8e}, "
            f"mean_edges={result['mean_edges']:.1f}"
        )

        # Weighted degree.
        print("Weighted degree...")
        result = run_budgeted_method(
            rho0,
            edges,
            weights,
            knn,
            rho_star,
            budget,
            "weighted_degree",
        )

        rows.append({
            "method": "weighted_degree",
            "target_edges": budget,
            "seed": "",
            **result,
        })

        print(
            f"  objective={result['final_objective']:.8e}, "
            f"dist={result['dist_to_optimum']:.8e}, "
            f"mean_edges={result['mean_edges']:.1f}"
        )

        # Random controls.
        for seed in RANDOM_SEEDS:
            print(f"Random seed {seed}...")

            rng = np.random.default_rng(seed)

            result = run_budgeted_method(
                rho0,
                edges,
                weights,
                knn,
                rho_star,
                budget,
                "random",
                rng=rng,
            )

            rows.append({
                "method": "random",
                "target_edges": budget,
                "seed": seed,
                **result,
            })

    # ---------------------------------------------------------
    # SUMMARY
    # ---------------------------------------------------------

    print("\nFINAL SUMMARY")

    for budget in TARGET_EDGE_BUDGETS:
        print(f"\nBudget ~{budget:,}")

        for method in [
            "adaptive",
            "weighted_degree",
            "random",
        ]:
            subset = [
                r
                for r in rows
                if r["target_edges"] == budget
                and r["method"] == method
            ]

            if method == "random":
                obj = np.mean([
                    r["final_objective"]
                    for r in subset
                ])
                obj_std = np.std([
                    r["final_objective"]
                    for r in subset
                ])

                dist = np.mean([
                    r["dist_to_optimum"]
                    for r in subset
                ])
                dist_std = np.std([
                    r["dist_to_optimum"]
                    for r in subset
                ])

                edges_mean = np.mean([
                    r["mean_edges"]
                    for r in subset
                ])
                edges_std = np.std([
                    r["mean_edges"]
                    for r in subset
                ])

                print(
                    f"{method:<18} "
                    f"objective={obj:.6e}±{obj_std:.2e}  "
                    f"dist={dist:.6e}±{dist_std:.2e}  "
                    f"edges={edges_mean:.1f}±{edges_std:.1f}"
                )

            else:
                r = subset[0]

                print(
                    f"{method:<18} "
                    f"objective={r['final_objective']:.6e}  "
                    f"dist={r['dist_to_optimum']:.6e}  "
                    f"edges={r['mean_edges']:.1f}"
                )

    # ---------------------------------------------------------
    # SAVE
    # ---------------------------------------------------------

    out = OUT / "pebble_optimization_matched_budget.csv"

    fields = [
        "method",
        "target_edges",
        "seed",
        "final_objective",
        "dist_to_optimum",
        "mean_edges",
        "final_edges",
    ]

    with out.open("w", newline="") as f:
        writer = csv.DictWriter(
            f,
            fieldnames=fields,
        )
        writer.writeheader()

        for row in rows:
            writer.writerow(row)

    print("\nSaved:", out)


if __name__ == "__main__":
    main()